# The two-mesh federation suite's node image (v3 item 2 PR 10b): one binary, three roles
# (`examples/federation_node.rs`). Same shape as docker/Dockerfile — dependency layer first.
FROM rust:1.88-slim AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY . .
RUN cargo build --release --features tls,a2a --example federation_node

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 curl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/examples/federation_node /usr/local/bin/federation-node
EXPOSE 57000
EXPOSE 8300
EXPOSE 8400
ENTRYPOINT ["federation-node"]
